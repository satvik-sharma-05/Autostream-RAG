# ── LLM ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=500
TEMPERATURE=0.3

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# Local dev:  ./data/chromadb
# Render:     /app/data/chromadb  (mounted persistent disk)
CHROMA_PERSIST_DIR=./data/chromadb
CHROMA_COLLECTION_NAME=autostream_kb
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── LangGraph checkpointer ────────────────────────────────────────────────────
CHECKPOINTER_PATH=./data/checkpoints.db

# ── Server ────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# ── CORS (comma-separated, or * for all) ─────────────────────────────────────
# Local:       http://localhost:5173,http://localhost:3000
# Production:  https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── WhatsApp (optional) ───────────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=autostream_verify
WHATSAPP_PHONE_NUMBER_ID=
